{
  "expo": {
    "name": "Toolverse",
    "slug": "toolverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "scheme": "toolverse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.toolverse.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7250284876062440~2450475494",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Toolverse to access your camera for QR scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Toolverse to access your photos for image tools."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Toolverse to save images to your gallery.",
          "savePhotosPermission": "Allow Toolverse to save images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
